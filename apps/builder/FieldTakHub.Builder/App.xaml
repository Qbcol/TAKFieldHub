<Application x:Class="FieldTakHub.Builder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Strings.en.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- TAK Field Hub 1.9 visual identity -->
      <SolidColorBrush x:Key="BrandBackgroundBrush" Color="#0B1114"/>
      <SolidColorBrush x:Key="BrandPanelBrush" Color="#102127"/>
      <SolidColorBrush x:Key="BrandPanelAltBrush" Color="#163038"/>
      <SolidColorBrush x:Key="BrandCyanBrush" Color="#28E0D7"/>
      <SolidColorBrush x:Key="BrandRedBrush" Color="#FF3B4E"/>
      <SolidColorBrush x:Key="BrandGoodBrush" Color="#59D17D"/>
      <SolidColorBrush x:Key="BrandTextBrush" Color="#F5F7F8"/>
      <SolidColorBrush x:Key="BrandMutedBrush" Color="#B7C5C9"/>
      <SolidColorBrush x:Key="BrandBorderBrush" Color="#46636A"/>

      <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BrandBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
      </Style>
      <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource BrandTextBrush}"/></Style>
      <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource BrandPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}"/>
        <Setter Property="Padding" Value="8"/>
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="32"/>
        <Setter Property="Background" Value="{StaticResource BrandPanelAltBrush}"/><Setter Property="Foreground" Value="{StaticResource BrandTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}"/><Setter Property="CaretBrush" Value="{StaticResource BrandCyanBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource BrandCyanBrush}"/>
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="32"/>
        <Setter Property="Background" Value="{StaticResource BrandPanelAltBrush}"/><Setter Property="Foreground" Value="{StaticResource BrandTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}"/>
      </Style>
      <Style TargetType="Button">
        <Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="36"/>
        <Setter Property="Background" Value="{StaticResource BrandPanelAltBrush}"/><Setter Property="Foreground" Value="{StaticResource BrandCyanBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrandCyanBrush}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>
      <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource BrandCyanBrush}"/><Setter Property="Foreground" Value="{StaticResource BrandBackgroundBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/><Setter Property="MinHeight" Value="42"/>
      </Style>
      <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource BrandRedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BrandRedBrush}"/>
      </Style>
      <Style x:Key="PanelBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}"/><Setter Property="Background" Value="{StaticResource BrandPanelBrush}"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="10"/>
      </Style>
      <Style TargetType="ListView">
        <Setter Property="Background" Value="{StaticResource BrandPanelBrush}"/><Setter Property="Foreground" Value="{StaticResource BrandTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}"/>
      </Style>
      <Style TargetType="ListViewItem"><Setter Property="Background" Value="{StaticResource BrandPanelBrush}"/><Setter Property="Foreground" Value="{StaticResource BrandTextBrush}"/></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
