<Window x:Class="FieldTakHub.Builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowTitle}" Height="960" Width="1260" MinHeight="780" MinWidth="1040"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Margin="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <ScrollViewer Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,14,0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Left">
            <TextBlock Text="{DynamicResource HeaderTitle}" FontWeight="Bold" FontSize="24"/>
            <TextBlock Text="{DynamicResource HeaderVersion}" Foreground="Gray" Margin="0,0,0,12"/>
          </StackPanel>
          <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="115" SelectionChanged="LanguageBox_SelectionChanged" AutomationProperties.Name="{DynamicResource Language}">
            <ComboBoxItem Tag="en" Content="{DynamicResource English}" IsSelected="True"/>
            <ComboBoxItem Tag="pl" Content="{DynamicResource Polish}"/>
          </ComboBox>
        </DockPanel>

        <TextBlock Text="{DynamicResource Project}" FontWeight="Bold" FontSize="16"/>
        <TextBlock Text="{DynamicResource Name}"/><TextBox x:Name="NameBox" Text="Field TAK Package" AutomationProperties.Name="{DynamicResource Name}"/>
        <TextBlock Text="{DynamicResource PackageId}"/><TextBox x:Name="IdBox" Text="local.fieldtak.package" AutomationProperties.Name="{DynamicResource PackageId}"/>
        <TextBlock Text="{DynamicResource Version}"/><TextBox x:Name="VersionBox" Text="2.0.0" AutomationProperties.Name="{DynamicResource Version}"/>
        <TextBlock Text="{DynamicResource Publisher}"/><TextBox x:Name="PublisherBox" AutomationProperties.Name="{DynamicResource Publisher}"/>

        <TextBlock Text="{DynamicResource Source}" FontWeight="Bold" FontSize="16" Margin="0,8,0,0"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource Browse}" Click="BrowseSource_Click" AutomationProperties.Name="{DynamicResource Browse}"/><TextBox x:Name="SourceBox" AutomationProperties.Name="{DynamicResource Source}"/></DockPanel>
        <TextBlock Text="{DynamicResource Output}"/><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource Browse}" Click="BrowseOutput_Click" AutomationProperties.Name="{DynamicResource Browse}"/><TextBox x:Name="OutputBox" AutomationProperties.Name="{DynamicResource Output}"/></DockPanel>

        <TextBlock Text="{DynamicResource AtakTarget}" FontWeight="Bold" FontSize="16" Margin="0,8,0,0"/>
        <DockPanel><TextBlock Text="{DynamicResource Min}" VerticalAlignment="Center" Width="40"/><TextBox x:Name="AtakMinBox" Width="110" Text="5.6"/><TextBlock Text="{DynamicResource Max}" VerticalAlignment="Center" Margin="16,0,0,0" Width="40"/><TextBox x:Name="AtakMaxBox" Width="110" Text="5.8"/></DockPanel>

        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource ServerConfig}" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="{DynamicResource ServerHelp}" TextWrapping="Wrap" Foreground="Gray" Margin="0,2,0,8"/>
            <TextBlock Text="{DynamicResource Type}"/><TextBox x:Name="ServerTypeBox" Text="OpenTAK"/>
            <TextBlock Text="{DynamicResource ServerName}"/><TextBox x:Name="ServerNameBox" Text="GGZS OpenTAK"/>
            <TextBlock Text="{DynamicResource Host}"/><TextBox x:Name="HostBox" Text="ggzstak.duckdns.org"/>
            <TextBlock Text="{DynamicResource Ports}" Margin="0,6,0,0"/>
            <WrapPanel>
              <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Cot}"/><TextBox x:Name="CotBox" Width="85" Text="8089"/></StackPanel>
              <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Api}"/><TextBox x:Name="ApiBox" Width="110" Text="8446"/></StackPanel>
              <StackPanel><TextBlock Text="{DynamicResource Web}"/><TextBox x:Name="WebBox" Width="85" Text="8443"/></StackPanel>
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0">
              <Button Content="{DynamicResource LoadServerTxt}" Click="LoadServerTxt_Click"/>
              <Button Content="{DynamicResource SaveServerTxt}" Click="SaveServerTxt_Click"/>
              <Button Content="{DynamicResource TestServer}" Click="TestServer_Click" FontWeight="SemiBold"/>
            </WrapPanel>
            <TextBlock Text="{DynamicResource ServerDefaultsNote}" TextWrapping="Wrap" Foreground="Gray" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>

        <DockPanel Margin="0,8,0,0"><TextBlock Text="{DynamicResource QrValidity}" VerticalAlignment="Center"/><TextBox x:Name="ExpiryBox" Width="75" Text="6"/></DockPanel>
        <DockPanel><TextBlock Text="{DynamicResource MaxDownloads}" VerticalAlignment="Center"/><TextBox x:Name="MaxDownloadsBox" Width="75" Text="50"/></DockPanel>

        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource Security}" FontWeight="Bold" FontSize="16"/>
            <TextBlock><Run Text="{DynamicResource Fingerprint}"/><Run Text=": "/><Run x:Name="FingerprintRun"/></TextBlock>
            <WrapPanel><Button Content="{DynamicResource ExportKey}" Click="ExportKey_Click"/><Button Content="{DynamicResource ImportKey}" Click="ImportKey_Click"/></WrapPanel>
          </StackPanel>
        </Border>

        <WrapPanel Margin="0,10,0,0">
          <Button Content="{DynamicResource LoadProject}" Click="LoadProject_Click"/>
          <Button Content="{DynamicResource SaveProject}" Click="SaveProject_Click"/>
          <Button Content="{DynamicResource Analyze}" Click="Analyze_Click"/>
          <Button Content="{DynamicResource BuildPackage}" Click="Build_Click" FontWeight="Bold"/>
        </WrapPanel>
        <Button Content="{DynamicResource CheckUpdates}" Click="CheckUpdates_Click" HorizontalAlignment="Left"/>
        <TextBlock Text="{DynamicResource AccessibilityHint}" TextWrapping="Wrap" Foreground="Gray" Margin="4,4,4,8"/>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
      <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
      <GroupBox Header="{DynamicResource ContentAnalysis}" Grid.Row="0">
        <ListView x:Name="ContentList" AutomationProperties.Name="{DynamicResource ContentAnalysis}">
          <ListView.View><GridView>
            <GridViewColumn Header="{DynamicResource Category}" DisplayMemberBinding="{Binding Category}" Width="150"/>
            <GridViewColumn Header="{DynamicResource Path}" DisplayMemberBinding="{Binding RelativePath}" Width="430"/>
            <GridViewColumn Header="{DynamicResource Bytes}" DisplayMemberBinding="{Binding Size}" Width="100"/>
          </GridView></ListView.View>
        </ListView>
      </GroupBox>

      <WrapPanel Grid.Row="1" Margin="0,10">
        <Button Content="{DynamicResource StartLan}" Click="StartServer_Click"/>
        <Button Content="{DynamicResource Stop}" Click="StopServer_Click"/>
        <TextBlock x:Name="UrlText" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </WrapPanel>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="0,0,12,0"><Image x:Name="QrImage" Stretch="Uniform" AutomationProperties.Name="Provisioning QR code"/></Border>
        <GroupBox Grid.Column="1" Header="{DynamicResource StatusDetails}"><TextBox x:Name="StatusBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource StatusDetails}"/></GroupBox>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{DynamicResource Footer}" Foreground="Gray" HorizontalAlignment="Right" Margin="0,12,0,0"/>
  </Grid>
</Window>
