<Window x:Class="FieldTakHub.Builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowTitle}" Height="760" Width="1280" MinHeight="600" MinWidth="980" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Icon="Assets/tak-field-hub-builder.ico">
  <ScrollViewer Margin="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                CanContentScroll="False" Focusable="False">
    <Grid Margin="12" MinWidth="1180" MinHeight="760">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,14,0">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Left">
            <TextBlock Text="{DynamicResource HeaderTitle}" FontWeight="Bold" FontSize="24"/>
            <TextBlock Text="{DynamicResource HeaderVersion}" Foreground="Gray" Margin="0,0,0,12"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="{DynamicResource BuilderModeLabel}" FontSize="11" Foreground="Gray"/>
              <ComboBox x:Name="BuilderModeBox" Width="145" SelectedIndex="0" SelectionChanged="BuilderModeBox_SelectionChanged" AutomationProperties.Name="{DynamicResource BuilderModeLabel}">
                <ComboBoxItem Tag="simple" Content="{DynamicResource BuilderModeSimple}"/>
                <ComboBoxItem Tag="advanced" Content="{DynamicResource BuilderModeAdvanced}"/>
              </ComboBox>
            </StackPanel>
            <ComboBox x:Name="LanguageBox" Width="115" SelectionChanged="LanguageBox_SelectionChanged" AutomationProperties.Name="{DynamicResource Language}">
            <ComboBoxItem Tag="en" Content="{DynamicResource English}" IsSelected="True"/>
            <ComboBoxItem Tag="pl" Content="{DynamicResource Polish}"/>
          </ComboBox>
          </StackPanel>
        </DockPanel>
        <TextBlock x:Name="AdvancedModeHint" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"/>

        <TextBlock Text="{DynamicResource Project}" FontWeight="Bold" FontSize="16"/>
        <WrapPanel Margin="0,0,0,4">
          <Button Content="{DynamicResource NewProject}" Click="NewProject_Click" FontWeight="SemiBold" AutomationProperties.Name="{DynamicResource NewProject}"/>
          <Button Content="{DynamicResource ImportLegacy}" Click="ImportLegacy_Click" AutomationProperties.Name="{DynamicResource ImportLegacy}"/>
          <Button Content="{DynamicResource LoadProject}" Click="LoadProject_Click" AutomationProperties.Name="{DynamicResource LoadProject}"/>
          <Button Content="{DynamicResource SaveProject}" Click="SaveProject_Click" AutomationProperties.Name="{DynamicResource SaveProject}"/>
          <Button Content="{DynamicResource OpenProjectFolder}" Click="OpenProjectFolder_Click" AutomationProperties.Name="{DynamicResource OpenProjectFolder}"/>
        </WrapPanel>
        <TextBlock Text="{DynamicResource Name}"/><TextBox x:Name="NameBox" Text="Field TAK Package" AutomationProperties.Name="{DynamicResource Name}"/>
        <TextBlock Text="{DynamicResource PackageId}"/><TextBox x:Name="IdBox" Text="local.fieldtak.package" AutomationProperties.Name="{DynamicResource PackageId}"/>
        <TextBlock Text="{DynamicResource Version}"/><TextBox x:Name="VersionBox" Text="1.0.0" AutomationProperties.Name="{DynamicResource Version}"/>
        <TextBlock Text="{DynamicResource Publisher}"/><TextBox x:Name="PublisherBox" AutomationProperties.Name="{DynamicResource Publisher}"/>

        <Border x:Name="AdvancedFoldersPanel" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource ProjectFolders}" FontWeight="Bold" FontSize="15"/>
            <TextBlock Text="{DynamicResource ProjectFoldersHelp}" TextWrapping="Wrap" Foreground="Gray" Margin="0,2,0,6"/>
            <UniformGrid Columns="2">
              <Border Margin="2" Padding="3" AllowDrop="True" Tag="atak" DragOver="ProjectFolder_DragOver" Drop="ProjectFolder_Drop"><DockPanel><TextBlock x:Name="AtakCountText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0"/><Button Content="{DynamicResource FolderAtak}" Tag="atak" Click="OpenSourceFolder_Click"/></DockPanel></Border>
              <Border Margin="2" Padding="3" AllowDrop="True" Tag="plugins" DragOver="ProjectFolder_DragOver" Drop="ProjectFolder_Drop"><DockPanel><TextBlock x:Name="PluginsCountText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0"/><Button Content="{DynamicResource FolderPlugins}" Tag="plugins" Click="OpenSourceFolder_Click"/></DockPanel></Border>
              <Border Margin="2" Padding="3" AllowDrop="True" Tag="maps" DragOver="ProjectFolder_DragOver" Drop="ProjectFolder_Drop"><DockPanel><TextBlock x:Name="MapsCountText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0"/><Button Content="{DynamicResource FolderMaps}" Tag="maps" Click="OpenSourceFolder_Click"/></DockPanel></Border>
              <Border Margin="2" Padding="3" AllowDrop="True" Tag="overlays" DragOver="ProjectFolder_DragOver" Drop="ProjectFolder_Drop"><DockPanel><TextBlock x:Name="OverlaysCountText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0"/><Button Content="{DynamicResource FolderOverlays}" Tag="overlays" Click="OpenSourceFolder_Click"/></DockPanel></Border>
              <Border Margin="2" Padding="3" AllowDrop="True" Tag="config" DragOver="ProjectFolder_DragOver" Drop="ProjectFolder_Drop"><DockPanel><TextBlock x:Name="ConfigCountText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0"/><Button Content="{DynamicResource FolderConfig}" Tag="config" Click="OpenSourceFolder_Click"/></DockPanel></Border>
              <Border Margin="2" Padding="3" AllowDrop="True" Tag="data" DragOver="ProjectFolder_DragOver" Drop="ProjectFolder_Drop"><DockPanel><TextBlock x:Name="DataCountText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0"/><Button Content="{DynamicResource FolderData}" Tag="data" Click="OpenSourceFolder_Click"/></DockPanel></Border>
              <Border Margin="2" Padding="3" AllowDrop="True" Tag="meshtastic" DragOver="ProjectFolder_DragOver" Drop="ProjectFolder_Drop"><DockPanel><TextBlock x:Name="MeshtasticCountText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0"/><Button Content="{DynamicResource FolderMeshtastic}" Tag="meshtastic" Click="OpenSourceFolder_Click"/></DockPanel></Border>
            </UniformGrid>
          </StackPanel>
        </Border>

        <Border x:Name="AdvancedMeshtasticPanel" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource MeshtasticConfigTitle}" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="{DynamicResource MeshtasticConfigHelp}" TextWrapping="Wrap" Foreground="Gray" Margin="0,2,0,8"/>
            <TextBlock Text="{DynamicResource MeshtasticMode}" Margin="0,6,0,0"/>
            <ComboBox x:Name="MeshtasticModeBox" SelectedIndex="0" AutomationProperties.Name="{DynamicResource MeshtasticMode}">
              <ComboBoxItem Content="HYBRID" Tag="hybrid"/>
              <ComboBoxItem Content="COMPATIBLE" Tag="compatible"/>
              <ComboBoxItem Content="DIRECT" Tag="direct"/>
            </ComboBox>
            <WrapPanel Margin="0,6,0,0">
              <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource MeshtasticDeviceRole}"/><ComboBox x:Name="MeshtasticDeviceRoleBox" Width="150" SelectedIndex="0" SelectionChanged="MeshtasticDeviceRoleBox_SelectionChanged" AutomationProperties.Name="{DynamicResource MeshtasticDeviceRole}"><ComboBoxItem Content="{DynamicResource MeshtasticDeviceRoleAuto}" Tag="auto"/><ComboBoxItem Content="{DynamicResource MeshtasticDeviceRoleFieldNode}" Tag="field_node"/><ComboBoxItem Content="{DynamicResource MeshtasticDeviceRoleGateway}" Tag="gateway"/></ComboBox></StackPanel>
              <StackPanel><TextBlock Text="{DynamicResource MeshtasticDeviceModel}"/><ComboBox x:Name="MeshtasticDeviceModelBox" Width="220" IsEditable="True" Text="generic_meshtastic" AutomationProperties.Name="{DynamicResource MeshtasticDeviceModel}"><ComboBoxItem Content="generic_meshtastic"/><ComboBoxItem Content="tbeam"/><ComboBoxItem Content="tbeam_supreme"/><ComboBoxItem Content="heltec_v3"/><ComboBoxItem Content="heltec_v4"/><ComboBoxItem Content="seeed_meshtracker_x1"/><ComboBoxItem Content="seeed_xiao_esp32s3"/><ComboBoxItem Content="seeed_xiao_nrf52840"/><ComboBoxItem Content="rak4631"/><ComboBoxItem Content="other"/></ComboBox></StackPanel>
            </WrapPanel>
            <TextBlock Text="{DynamicResource MeshtasticDeviceHelp}" TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,0"/>
            <WrapPanel Margin="0,6,0,0">
              <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource MeshtasticRegion}"/><TextBox x:Name="MeshtasticRegionBox" Width="90" Text="EU_868"/></StackPanel>
              <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource MeshtasticPreset}"/><TextBox x:Name="MeshtasticPresetBox" Width="110" Text="SHORT_FAST"/></StackPanel>
              <StackPanel><TextBlock Text="{DynamicResource MeshtasticHopLimit}"/><TextBox x:Name="MeshtasticHopBox" Width="55" Text="3"/></StackPanel>
            </WrapPanel>
            <WrapPanel Margin="0,6,0,0">
              <CheckBox x:Name="MeshtasticPliBox" Content="PLI" IsChecked="True" Margin="0,0,12,0"/>
              <CheckBox x:Name="MeshtasticGeoChatBox" Content="GeoChat" IsChecked="True" Margin="0,0,12,0"/>
              <CheckBox x:Name="MeshtasticOtsBox" Content="OTS Relay" IsChecked="True" Margin="0,0,12,0"/>
              <CheckBox x:Name="MeshtasticFileBox" Content="File Transfer" IsChecked="False"/>
            </WrapPanel>
            <TextBlock Text="{DynamicResource MeshtasticChannelName}" Margin="0,6,0,0"/>
            <TextBox x:Name="MeshtasticChannelNameBox" Text="GGZS-TAK" AutomationProperties.Name="{DynamicResource MeshtasticChannelName}"/>
            <TextBlock Text="{DynamicResource MeshtasticChannelUrl}" Margin="0,6,0,0"/>
            <TextBox x:Name="MeshtasticUrlBox" MinHeight="54" TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource MeshtasticChannelUrl}"/>
            <TextBlock x:Name="MeshtasticStatusText" TextWrapping="Wrap" Foreground="Gray" Margin="0,6,0,0"/>
            <WrapPanel Margin="0,8,0,0">
              <Button Content="{DynamicResource MeshtasticSave}" Click="MeshtasticSave_Click" FontWeight="SemiBold"/>
              <Button Content="{DynamicResource MeshtasticOpen}" Click="MeshtasticOpen_Click"/>
              <Button Content="{DynamicResource MeshtasticCopy}" Click="MeshtasticCopy_Click"/>
              <Button Content="{DynamicResource MeshtasticClear}" Click="MeshtasticClear_Click"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border x:Name="AdvancedGatewayPanel" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource MeshtasticGatewayTitle}" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="{DynamicResource MeshtasticGatewayHelp}" TextWrapping="Wrap" Foreground="Gray" Margin="0,2,0,8"/>
            <CheckBox x:Name="MeshtasticGatewayEnabledBox" Content="{DynamicResource MeshtasticGatewayEnabled}" IsChecked="False"/>
            <WrapPanel Margin="0,6,0,0">
              <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource MeshtasticGatewayType}"/><TextBox x:Name="MeshtasticGatewayTypeBox" Width="190" Text="generic_meshtastic"/></StackPanel>
              <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource MeshtasticGatewayRole}"/><TextBox x:Name="MeshtasticGatewayRoleBox" Width="100" Text="ots_mqtt"/></StackPanel>
              <StackPanel><TextBlock Text="{DynamicResource MeshtasticGatewayTransport}"/><TextBox x:Name="MeshtasticGatewayTransportBox" Width="100" Text="mqtt_tls"/></StackPanel>
            </WrapPanel>
            <WrapPanel Margin="0,6,0,0">
              <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource MeshtasticGatewayMqttPort}"/><TextBox x:Name="MeshtasticGatewayMqttPortBox" Width="70" Text="8883"/></StackPanel>
              <StackPanel><TextBlock Text="{DynamicResource MeshtasticGatewayRootTopic}"/><TextBox x:Name="MeshtasticGatewayRootTopicBox" Width="150" Text="opentakserver"/></StackPanel>
            </WrapPanel>
            <CheckBox x:Name="MeshtasticGatewaySecretsExternalBox" Content="{DynamicResource MeshtasticGatewaySecretsExternal}" IsChecked="True" IsEnabled="False" Margin="0,7,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource Source}" FontWeight="Bold" FontSize="16" Margin="0,8,0,0"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource Browse}" Click="BrowseSource_Click" AutomationProperties.Name="{DynamicResource Browse}"/><TextBox x:Name="SourceBox" AutomationProperties.Name="{DynamicResource Source}"/></DockPanel>
        <TextBlock Text="{DynamicResource Output}"/><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource Browse}" Click="BrowseOutput_Click" AutomationProperties.Name="{DynamicResource Browse}"/><TextBox x:Name="OutputBox" AutomationProperties.Name="{DynamicResource Output}"/></DockPanel>

        <TextBlock Text="{DynamicResource AtakTarget}" FontWeight="Bold" FontSize="16" Margin="0,8,0,0"/>
        <DockPanel><TextBlock Text="{DynamicResource Min}" VerticalAlignment="Center" Width="40"/><TextBox x:Name="AtakMinBox" Width="110" Text="5.6"/><TextBlock Text="{DynamicResource Max}" VerticalAlignment="Center" Margin="16,0,0,0" Width="40"/><TextBox x:Name="AtakMaxBox" Width="110" Text="5.8"/></DockPanel>

        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource ServerConfig}" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="{DynamicResource ServerHelp}" TextWrapping="Wrap" Foreground="Gray" Margin="0,2,0,8"/>
            <TextBlock Text="{DynamicResource Type}"/><TextBox x:Name="ServerTypeBox" Text="OpenTAK"/>
            <TextBlock Text="{DynamicResource ServerName}"/><TextBox x:Name="ServerNameBox" Text="GGZS OpenTAK"/>
            <TextBlock Text="{DynamicResource Host}"/><TextBox x:Name="HostBox" Text="ggzstak.duckdns.org"/>
            <TextBlock Text="{DynamicResource Ports}" Margin="0,6,0,0"/>
            <WrapPanel>
              <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Cot}"/><TextBox x:Name="CotBox" Width="85" Text="8089"/></StackPanel>
              <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Api}"/><TextBox x:Name="ApiBox" Width="110" Text="8446"/></StackPanel>
              <StackPanel><TextBlock Text="{DynamicResource Web}"/><TextBox x:Name="WebBox" Width="85" Text="8443"/></StackPanel>
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0">
              <Button Content="{DynamicResource LoadServerTxt}" Click="LoadServerTxt_Click"/>
              <Button Content="{DynamicResource SaveServerTxt}" Click="SaveServerTxt_Click"/>
              <Button Content="{DynamicResource TestServer}" Click="TestServer_Click" FontWeight="SemiBold"/>
            </WrapPanel>
            <TextBlock Text="{DynamicResource ServerDefaultsNote}" TextWrapping="Wrap" Foreground="Gray" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>

        <Border x:Name="AdvancedEnrollmentPanel" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource EnrollmentConfigTitle}" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="{DynamicResource EnrollmentConfigHelp}" TextWrapping="Wrap" Foreground="Gray" Margin="0,2,0,8"/>
            <TextBlock Text="{DynamicResource EnrollmentUri}"/>
            <TextBox x:Name="EnrollmentUriBox" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource EnrollmentUri}"/>
            <TextBlock x:Name="EnrollmentStatusText" TextWrapping="Wrap" Foreground="Gray" Margin="0,6,0,0"/>
            <WrapPanel Margin="0,8,0,0">
              <Button Content="{DynamicResource EnrollmentSave}" Click="EnrollmentSave_Click" FontWeight="SemiBold"/>
              <Button Content="{DynamicResource EnrollmentClear}" Click="EnrollmentClear_Click"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <DockPanel Margin="0,8,0,0"><TextBlock Text="{DynamicResource PackageValidity}" VerticalAlignment="Center"/><TextBox x:Name="PackageExpiryBox" Width="75" Text="6"/></DockPanel>
        <DockPanel><TextBlock Text="{DynamicResource QrValidity}" VerticalAlignment="Center"/><TextBox x:Name="QrExpiryBox" Width="75" Text="6"/></DockPanel>
        <DockPanel><TextBlock Text="{DynamicResource MaxDownloads}" VerticalAlignment="Center"/><TextBox x:Name="MaxDownloadsBox" Width="75" Text="50"/></DockPanel>

        <Border x:Name="AdvancedSecurityPanel" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource Security}" FontWeight="Bold" FontSize="16"/>
            <TextBlock><Run Text="{DynamicResource Fingerprint}"/><Run Text=": "/><Run x:Name="FingerprintRun"/></TextBlock>
            <WrapPanel><Button Content="{DynamicResource ExportKey}" Click="ExportKey_Click"/><Button Content="{DynamicResource ImportKey}" Click="ImportKey_Click"/></WrapPanel>
          </StackPanel>
        </Border>

        <WrapPanel Margin="0,10,0,0">
          <Button Content="{DynamicResource RepairFolders}" Click="RepairFolders_Click"/>
          <Button Content="{DynamicResource Analyze}" Click="Analyze_Click"/>
          <Button Content="{DynamicResource BuildPackage}" Click="Build_Click" FontWeight="Bold"/>
        </WrapPanel>
        <Button Content="{DynamicResource CheckUpdates}" Click="CheckUpdates_Click" HorizontalAlignment="Left"/>
        <TextBlock Text="{DynamicResource AccessibilityHint}" TextWrapping="Wrap" Foreground="Gray" Margin="4,4,4,8"/>
      </StackPanel>

    <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
      <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
      <GroupBox Header="{DynamicResource ContentAnalysis}" Grid.Row="0">
        <ListView x:Name="ContentList" AutomationProperties.Name="{DynamicResource ContentAnalysis}">
          <ListView.View><GridView>
            <GridViewColumn Header="{DynamicResource Category}" DisplayMemberBinding="{Binding Category}" Width="120"/>
            <GridViewColumn Header="{DynamicResource Path}" DisplayMemberBinding="{Binding RelativePath}" Width="300"/>
            <GridViewColumn Header="{DynamicResource Bytes}" DisplayMemberBinding="{Binding Size}" Width="80"/>
          </GridView></ListView.View>
        </ListView>
      </GroupBox>

      <StackPanel Grid.Row="1" Margin="0,10,0,8">
        <GroupBox Header="{DynamicResource DistributionLan}">
          <WrapPanel Margin="6">
            <Button Content="{DynamicResource StartLan}" Click="StartServer_Click"/>
            <Button Content="{DynamicResource Stop}" Click="StopServer_Click"/>
            <TextBlock x:Name="UrlText" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </WrapPanel>
        </GroupBox>
        <GroupBox Header="{DynamicResource CloudDistribution}" Margin="0,8,0,0">
          <StackPanel Margin="8">
            <TextBlock Text="{DynamicResource CloudHelp}" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6"/>
            <TextBlock Text="{DynamicResource LocalPackage}"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{DynamicResource SelectFtak}" Click="SelectCloudPackage_Click"/>
              <TextBox x:Name="CloudPackageBox" IsReadOnly="True" AutomationProperties.Name="{DynamicResource LocalPackage}"/>
            </DockPanel>
            <TextBlock Text="{DynamicResource ExternalPackageUrl}" Margin="0,5,0,0"/>
            <TextBox x:Name="CloudUrlBox" AutomationProperties.Name="{DynamicResource ExternalPackageUrl}"/>
            <WrapPanel Margin="0,7,0,0">
              <Button Content="{DynamicResource TestCloudLink}" Click="TestCloudLink_Click"/>
              <Button Content="{DynamicResource GenerateCloudQr}" Click="GenerateCloudQr_Click" FontWeight="SemiBold"/>
              <Button Content="{DynamicResource CopyDeepLink}" Click="CopyCloudDeepLink_Click"/>
            </WrapPanel>
            <TextBlock x:Name="CloudStatusText" TextWrapping="Wrap" Foreground="Gray" Margin="2,4,2,0"/>
          </StackPanel>
        </GroupBox>
      </StackPanel>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
          <Border BorderBrush="#DDD" BorderThickness="1" Padding="8"><Image x:Name="QrImage" Height="250" Stretch="Uniform" AutomationProperties.Name="Provisioning QR code"/></Border>
          <Button Content="{DynamicResource SaveQrPng}" Click="SaveQr_Click" Margin="0,6,0,0"/>
        </StackPanel>
        <GroupBox Grid.Column="1" Header="{DynamicResource StatusDetails}"><TextBox x:Name="StatusBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource StatusDetails}"/></GroupBox>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{DynamicResource Footer}" Foreground="Gray" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </Grid>
  </ScrollViewer>
</Window>
