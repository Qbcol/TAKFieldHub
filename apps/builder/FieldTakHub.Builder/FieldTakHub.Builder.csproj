<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FieldTakHub.Builder</AssemblyName>
    <RootNamespace>FieldTakHub.Builder</RootNamespace>
    <Version>2.1.0-rc1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
      <None Include="update-config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
